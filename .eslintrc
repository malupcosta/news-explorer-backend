{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "quotes": ["error", "double"],
    "no-console": "off",
    "linebreak-style": "off",
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "LineComment[value=/eslint-disable/]",
        "message": "eslint-disable comments are not allowed"
      },
      {
        "selector": "BlockComment[value=/eslint-disable/]",
        "message": "eslint-disable comments are not allowed"
      }
    ]
  }
}
